{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "seed:dev": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/seed-dev-user.ts",
    "seed:testers:dev": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/seed-testers.ts --branch=dev",
    "seed:testers:prod": "tsx --env-file-if-exists=../lib/db/.env.production.backup ./src/seed-testers.ts --branch=prod",
    "dev-db:check": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/dev-db-check.ts",
    "verify:tester-logins": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/verify-tester-logins.ts",
    "screenshot": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/screenshot.ts",
    "companion:observe": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/companion-observe.ts",
    "sw:reload-check": "tsx ./src/sw-reload-check.ts",
    "inspect": "tsx --env-file-if-exists=../artifacts/api-server/.env ./src/inspect.ts",
    "verify:inspect-assertions": "tsx ./src/verify-inspect-assertions.ts",
    "backfill:dev": "tsx --env-file-if-exists=../lib/db/.env ./src/backfill-tx-rates.ts --branch=dev",
    "backfill:prod": "tsx --env-file-if-exists=../lib/db/.env.production.backup ./src/backfill-tx-rates.ts --branch=prod",
    "verify:fx-drift:dev": "tsx --env-file-if-exists=../lib/db/.env ./src/verify-fx-drift.ts --branch=dev",
    "verify:fx-drift:prod": "tsx --env-file-if-exists=../lib/db/.env.production.backup ./src/verify-fx-drift.ts --branch=prod",
    "verify:tx-rate-lock:dev": "tsx --env-file-if-exists=../lib/db/.env ./src/verify-tx-rate-lock.ts --branch=dev",
    "verify:tx-rate-lock:prod": "tsx --env-file-if-exists=../lib/db/.env.production.backup ./src/verify-tx-rate-lock.ts --branch=prod",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx ./src/app-routes.test.ts && tsx ./src/capture-lock.test.ts && tsx ./src/account-prefs.test.ts && tsx ./src/fabricated-zeros.test.ts && tsx ./src/dev-db-schema-only.test.ts"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "better-auth": "^1.6.23",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "1.61.1",
    "tsx": "catalog:"
  }
}
